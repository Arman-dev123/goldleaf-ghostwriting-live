# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep this in a local .env file and never commit it to source control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL for your Supabase project.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public anonymous API key; safe for frontend use only if needed.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Secret server-side key; never expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=""

# SANITY_PROJECT_ID: The Project ID for your Sanity CMS.
SANITY_PROJECT_ID=""

# SANITY_DATASET: The dataset name for Sanity CMS (usually "production").
SANITY_DATASET="production"

# Gmail SMTP credentials for email notifications.
# Keep these in a local .env file and rotate them periodically.
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD=""
